# Environment variables - NEVER upload
.env

# Python cache
__pycache__/
*.pyc
*.pyo
venv/
env/
.venv/

# Cowrie live logs - can contain real attacker data
cowrie-logs/*.json
cowrie-logs/*.log
downloads/*

# Keep the folders but not sensitive content
!cowrie-logs/.gitkeep
!downloads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Reports with sensitive data
reports/raw_*.txt
